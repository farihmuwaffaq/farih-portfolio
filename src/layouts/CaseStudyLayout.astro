---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
interface Props { project: CollectionEntry<'work'> }
const { project } = Astro.props;
const d = project.data;
const breadcrumb = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:new URL('/',Astro.site)}, {'@type':'ListItem',position:2,name:'Work',item:new URL('/work',Astro.site)}, {'@type':'ListItem',position:3,name:d.title,item:Astro.url}
]};
const creative = {'@context':'https://schema.org','@type':'CreativeWork',name:d.title,description:d.summary,author:{'@type':'Person',name:'Farih Muwaffaq'},isBasedOn:d.evidenceType};
---
<BaseLayout title={`${d.title} | Farih Muwaffaq`} description={d.summary} type="article" jsonLd={[breadcrumb,creative]}>
  <section class="section"><div class="container">
    <a href="/work">← All work</a><p class="eyebrow">{d.evidenceType} · {d.industry}</p><h1>{d.title}</h1><p class="lede">{d.summary}</p>
    {d.confidential && <p class="notice"><strong>Confidentiality note:</strong> {d.confidentialityNote}</p>}
    <dl class="meta"><div><dt>Organization</dt><dd>{d.organization}</dd></div><div><dt>Role</dt><dd>{d.role}</dd></div><div><dt>Timeline</dt><dd>{d.timeline}</dd></div><div><dt>Tools</dt><dd>{d.tools.join(', ')}</dd></div></dl>
    <img src={d.coverImage} alt={d.coverAlt} width="1200" height="675" />
    {d.outcomes.length > 0 && <div class="outcomes" aria-label="Validated outcomes">{d.outcomes.map(outcome => <div class="outcome">{outcome}</div>)}</div>}
    <article class="prose"><slot /></article>
    <section class="prose"><h2>Related evidence</h2>{d.relatedAssets.length ? <ul>{d.relatedAssets.map(asset => <li>{asset.available && asset.href ? <a href={asset.href} data-event="open_project_asset" data-event-label={asset.label}>{asset.label}</a> : <span><strong>{asset.label}</strong> — {asset.note || 'Not publicly available.'}</span>}</li>)}</ul> : <p>No public assets are attached to this case study.</p>}</section>
    <div class="actions"><a class="button" href="/contact" data-event="case_study_contact">Discuss this work</a><a class="button secondary" href="/work">Explore more work</a></div>
  </div></section>
</BaseLayout>
