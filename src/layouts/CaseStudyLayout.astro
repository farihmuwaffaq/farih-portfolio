---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Lightbox from '../components/Lightbox.astro';
import DeckLibrary from '../components/DeckLibrary.astro';
interface Props { project: CollectionEntry<'work'> }
const { project } = Astro.props;
const d = project.data;
const breadcrumb = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:new URL('/',Astro.site)},{'@type':'ListItem',position:2,name:'Work',item:new URL('/work',Astro.site)},{'@type':'ListItem',position:3,name:d.title,item:Astro.url}]};
const creative = {'@context':'https://schema.org','@type':'CreativeWork',name:d.title,description:d.summary,author:{'@type':'Person',name:'Farih Muwaffaq'},isBasedOn:d.evidenceType};
const imageAssets = d.relatedAssets.filter(asset=>asset.type==='image'&&asset.available&&asset.href);
const otherAssets = d.relatedAssets.filter(asset=>asset.type!=='image'||!asset.available||!asset.href);
const allProjects = await getCollection('work');
const caseOrder = ['analytics-automation','nexus-bi-platform','loan-default-model','lifepack-delivery-margin-analysis','healthtech-data-infrastructure','fmcg-operations-analytics','carbon-methodology-assessment','retail-sales-datamart','shopee-pricing-tracker'];
const orderedProjects = [...allProjects].sort((a,b)=>caseOrder.indexOf(a.data.slug)-caseOrder.indexOf(b.data.slug));
const currentIndex = orderedProjects.findIndex(item=>item.data.slug===d.slug);
const previousCase = orderedProjects[(currentIndex - 1 + orderedProjects.length) % orderedProjects.length];
const nextCase = orderedProjects[(currentIndex + 1) % orderedProjects.length];
const relatedProjects = allProjects
  .filter(entry=>entry.data.slug!==d.slug)
  .map(entry=>({entry,overlap:entry.data.categories.filter(category=>d.categories.includes(category)).length}))
  .sort((a,b)=>b.overlap-a.overlap||Number(b.entry.data.featured)-Number(a.entry.data.featured))
  .slice(0,2)
  .map(item=>item.entry);
---
<BaseLayout title={`${d.title} | Farih Muwaffaq`} description={d.summary} image={`/social/cases/${d.slug}.png`} type="article" jsonLd={[breadcrumb,creative]}>
  <div class="case-progress" data-case-progress aria-hidden="true"><span></span></div>
  <section class="section case-hero"><div class="container">
    <p class="mono rise"><a href="/work">← Work index</a> / {d.organization}</p>
    <div class="case-title-grid">
      <div class="case-title"><p class="eyebrow rise rise-1"><span class="idx">{d.evidenceType}</span> {d.industry}</p><h1 class="rise rise-2">{d.title}</h1><p class="lede rise rise-3">{d.summary}</p>{d.confidential&&<span class="status confidential"><Icon name="lock" /> Published with protected details</span>}</div>
      <figure class="surface case-cover rise rise-2"><div class="surface-core case-cover-core"><img src={d.coverImage} alt={d.coverAlt} width="1600" height="900" /></div></figure>
    </div>
    <dl class="case-spec rise rise-3"><div><dt>Organization</dt><dd>{d.organization}</dd></div><div><dt>Role</dt><dd>{d.role}</dd></div><div><dt>Timeline</dt><dd>{d.timeline}</dd></div><div><dt>Stack</dt><dd>{d.tools.join(' · ')}</dd></div></dl>
    <aside class="evidence-status rise rise-3" aria-labelledby="evidence-status-title"><div><p class="eyebrow">Evidence status</p><h2 id="evidence-status-title">{d.evidenceStatus}</h2></div><p>{d.evidenceNote}</p></aside>
    {d.impactHighlights&&<section class="impact-highlights" aria-labelledby="impact-highlights-title"><div class="impact-highlights-intro"><p class="eyebrow">Business-level outcomes</p><h2 id="impact-highlights-title">Impact during the engagement.</h2><p>Team outcomes supported by my analysis and broader operational execution.</p></div><div class="impact-highlight-grid">{d.impactHighlights.map(item=><article><strong>{item.value}</strong><h3>{item.label}</h3><p>{item.context}</p></article>)}</div></section>}
    {d.confidential&&<aside class="notice"><Icon name="lock" /><div><strong>Privacy boundary</strong><p>{d.confidentialityNote}</p></div></aside>}
    {d.keyContributions&&<section class="contribution-block" data-reveal><div class="contribution-heading"><span class="eyebrow">My role</span><h2>My contribution.</h2><p>Work I directly owned or delivered within the broader team effort.</p></div><ol class="contribution-list">{d.keyContributions.map((item,i)=><li><span>{String(i+1).padStart(2,'0')}</span><p>{item}</p></li>)}</ol></section>}
    <section class="analysis-frame" aria-label="Analytical decisions and boundaries">
      <div class="assumption-panel"><p class="eyebrow">Analysis frame</p><h2 class="assumptions-title"><span class="sr-only">Assumptions / constraints</span><span class="assumptions-title-lines" aria-hidden="true"><span>Assumptions</span><span>/</span><span>constraints</span></span></h2><ul>{d.assumptionsConstraints.map(item=><li>{item}</li>)}</ul></div>
      <div class="decision-panel"><p class="eyebrow">Technical judgment</p><h2>Decision log</h2><ol class="decision-log">{d.decisionLog.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><div><strong>{item.decision}</strong><small>Why</small><p>{item.why}</p></div></li>)}</ol></div>
    </section>
    {d.deckLibrary&&<DeckLibrary library={d.deckLibrary} />}
    {d.dictionary&&<details class="data-dictionary"><summary><span><span class="eyebrow">Domain reference</span><strong>Metric dictionary</strong></span><span class="mono">View definitions +</span></summary><dl>{d.dictionary.map(item=><div><dt>{item.term}</dt><dd>{item.definition}</dd></div>)}</dl></details>}
    <article class="prose"><slot /></article>
    {d.outcomes.length>0&&<section class="case-outcome" aria-labelledby="outcome-title"><div class="case-outcome-heading"><p class="eyebrow"><span class="idx">Outcome</span> Validated evidence</p><h2 id="outcome-title">What changed.</h2><p>Published outcomes stay within what can be supported by project evidence.</p></div><div class="outcome-grid">{d.outcomes.map(outcome=><p>{outcome}</p>)}</div></section>}
    {imageAssets.length>0&&<section class="evidence-gallery" aria-labelledby="evidence-title"><div class="evidence-heading"><p class="eyebrow"><span class="idx">Evidence</span> Selected frames</p><h2 id="evidence-title">Selected evidence.</h2><p>Published views are selected for clarity and privacy. Open any frame to inspect it at full size.</p></div><div class="evidence-grid">{imageAssets.map((asset,i)=><Lightbox id={`evidence-${i}`} src={asset.href!} alt={asset.label} caption={asset.label} index={i+1} variant={imageAssets.length===1||i%3===2?'featured':'standard'} />)}</div></section>}
    {otherAssets.length>0&&<section class="section"><h2>Related assets</h2><ul class="asset-list">{otherAssets.map(asset=><li><span>{asset.label}</span>{asset.available&&asset.href?<a href={asset.href} target="_blank" rel="noreferrer">Open asset <Icon name="arrow-up-right" /></a>:<span class="status">Not public</span>}</li>)}</ul></section>}
    <section class="related-work" aria-labelledby="related-title"><div class="evidence-heading"><p class="eyebrow"><span class="idx">Next</span> Related work</p><div><h2 id="related-title">Other evidence.</h2><p>Projects selected by adjacent capability, not chronology.</p></div></div><div class="related-grid">{relatedProjects.map(item=><a href={`/work/${item.data.slug}`} data-event="related_work_click" data-event-label={item.data.slug}><span class="mono">{item.data.categories[0]}</span><h3>{item.data.title}</h3><p>{item.data.outcomes[0]||item.data.summary}</p><Icon name="arrow-up-right" /></a>)}</div></section>
    <nav class="case-navigation" aria-label="Case study navigation"><div class="case-navigation-grid"><a href={`/work/${previousCase.data.slug}`} data-event="related_work_click" data-event-label={previousCase.data.slug}><span class="mono">← Previous case</span><strong>{previousCase.data.title}</strong><small>{previousCase.data.categories[0]}</small></a><a href={`/work/${nextCase.data.slug}`} data-event="related_work_click" data-event-label={nextCase.data.slug}><span class="mono">Next case →</span><strong>{nextCase.data.title}</strong><small>{nextCase.data.categories[0]}</small></a></div></nav>
    <section class="section case-cta"><p class="eyebrow"><span class="idx">Contact</span> Continue the conversation</p><h2>Want to discuss how this system was built?</h2><div class="actions"><a class="button" href="/contact">Discuss this work<Icon name="arrow-up-right" /></a><a class="button secondary" href="/work">Explore more work<Icon name="arrow-right" /></a></div></section>
  </div></section>
</BaseLayout>
