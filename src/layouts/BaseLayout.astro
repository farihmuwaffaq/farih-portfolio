---
import '../styles/global.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import { getCollection } from 'astro:content';
import { nav, site, social } from '../data/site';
import Icon from '../components/Icon.astro';
interface Props { title: string; description?: string; image?: string; type?: 'website'|'article'; jsonLd?: Record<string, unknown>|Record<string, unknown>[]; animate?: boolean; footerVariant?: 'default'|'compact'|'resume' }
const { title, description = site.description, image = '/social/social-card.svg', type = 'website', jsonLd, footerVariant = 'default' } = Astro.props;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '';
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
const queryProjectIndex = (await getCollection('work'))
  .sort((a,b)=>a.data.title.localeCompare(b.data.title))
  .map(project=>({
    title: project.data.title,
    slug: project.data.slug,
    summary: project.data.summary,
    categories: project.data.categories,
    organization: project.data.organization,
    problem: project.data.summary,
    decisions: project.data.decisionLog,
    constraints: project.data.assumptionsConstraints,
    evidenceStatus: project.data.evidenceStatus,
    evidenceNote: project.data.evidenceNote,
  }));
const serializedQueryProjectIndex = JSON.stringify(queryProjectIndex).replace(/</g, '\\u003c');
const schemas = [
  { '@context':'https://schema.org','@type':'WebSite', name:`${site.name} Portfolio`, url:Astro.site?.toString() },
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#fafaf7" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:type" content={type} /><meta property="og:title" content={title} />
  <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site)} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <title>{title}</title>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemas)} />
  {gaMeasurementId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>}
  <script is:inline>
    try {
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('fm-intro-seen')) document.documentElement.classList.add('intro-pending');
    } catch (error) {
      document.documentElement.classList.remove('intro-pending');
    }
  </script>
  <noscript><style>.identity-intro{display:none!important}</style></noscript>
</head>
<body>
  <div class="identity-intro" role="dialog" aria-modal="true" aria-label="Meet Farih Muwaffaq">
    <div class="intro-frame">
      <div class="intro-top"><span class="brand-mark">FM<em>/</em></span><span class="mono">01 / IDENTITY</span></div>
      <div class="intro-core">
        <div class="intro-status mono" aria-hidden="true"><span>Initializing</span><span>System ready <i></i></span></div>
        <p class="intro-name">Farih Muwaffaq</p>
        <p class="intro-role">Data Analyst · Jakarta</p>
        <p class="intro-signals" aria-label="Data, systems, decisions"><span>Data</span><i>/</i><span>Systems</span><i>/</i><span>Decisions</span></p>
        <div class="intro-progress" aria-hidden="true"><i></i><b></b></div>
      </div>
      <button class="intro-enter" type="button" data-intro-enter>Enter portfolio <span>↗</span></button>
    </div>
  </div>
  <a class="skip-link" href="#main">Skip to main content</a>
  <header class="site-header"><nav class="nav" aria-label="Primary navigation">
    <a class="brand" href="/"><span class="brand-mark">FM<em>/</em></span><span class="brand-role">Data Analyst — Jakarta</span></a>
    <div class="nav-shell"><ul class="nav-links" id="primary-links">{nav.map(([label,href], i) => <li><a href={href} aria-current={(href==='/' ? current==='/' : current.startsWith(href)) ? 'page' : undefined}><sup>{String(i+1).padStart(2,'0')}</sup>{label}</a></li>)}</ul><button class="query-trigger" type="button" data-query-console-open aria-label="Open portfolio query console">SQL<span aria-hidden="true">_</span></button><a class="nav-cta" href={current.startsWith('/contact')?'#message-form':'/contact'}>Start a conversation <Icon name="arrow-up-right" /></a></div>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation"><span class="sr-only">Toggle navigation</span><i></i><i></i></button>
  </nav></header>
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-top"><a class="brand" href="/" tabindex="-1"><span class="brand-mark">FM<em>/</em></span></a><button class="mobile-menu-close" type="button" aria-label="Close navigation"><i></i><i></i></button></div>
    <nav class="mobile-menu-nav" aria-label="Mobile navigation"><ul>{nav.map(([label,href], i) => <li><a href={href} aria-current={(href==='/' ? current==='/' : current.startsWith(href)) ? 'page' : undefined} tabindex="-1"><sup>{String(i+1).padStart(2,'0')}</sup>{label}</a></li>)}</ul></nav>
    <div class="mobile-menu-footer"><button class="query-trigger mobile-query-trigger" type="button" data-query-console-open tabindex="-1">SQL_ <span>Query portfolio</span></button><a class="mobile-menu-cta" href={`mailto:${site.email}`} tabindex="-1">Start a conversation <Icon name="arrow-up-right" /></a><div>{social.map(([label,href])=><a href={href} target="_blank" rel="noreferrer" tabindex="-1">{label}</a>)}</div></div>
  </div>
  <div class="nav-backdrop" aria-hidden="true"></div>
  <div class="query-transition" data-query-transition aria-hidden="true">
    <div class="query-transition-frame">
      <div class="query-transition-top"><span>FM/ QUERY CONSOLE</span><span data-query-clock>00:00</span></div>
      <div class="query-transition-code" aria-live="polite"><span class="query-route" data-query-route>QUERY / PORTFOLIO</span><pre data-query-code></pre><span class="query-cursor" aria-hidden="true"></span></div>
      <div class="query-transition-result"><span data-query-status>EXECUTING QUERY</span><strong data-query-output></strong><span data-query-opening></span></div>
    </div>
  </div>
  <dialog class="query-console" data-query-console aria-labelledby="query-console-title">
    <div class="query-console-shell">
      <header><div><span class="brand-mark">FM<em>/</em></span><span id="query-console-title">QUERY PORTFOLIO</span></div><button type="button" data-query-console-close aria-label="Close query console">ESC <span>Close</span></button></header>
      <form data-query-console-form role="search"><label for="portfolio-query">Query portfolio</label><span aria-hidden="true">›</span><input id="portfolio-query" name="query" type="search" autocomplete="off" spellcheck="false" placeholder="Try work, skills, contact, or a project name" /></form>
      <div class="query-console-results" data-query-console-results aria-live="polite"><p class="query-console-hint">Type <kbd>help</kbd> for commands or search nine case studies.</p></div>
      <footer><span>SQL_ INTERFACE</span><span><kbd>↵</kbd> Run · <kbd>Esc</kbd> Close</span></footer>
    </div>
  </dialog>
  <script is:inline type="application/json" id="query-project-index" set:html={serializedQueryProjectIndex} />
  <main id="main" tabindex="-1"><slot /></main>
  <footer class:list={['site-footer',footerVariant==='compact'&&'footer-compact',footerVariant==='resume'&&'footer-resume']}>
    {footerVariant!=='compact' && <div class="container footer-cta">
      <div><p class="eyebrow">Direct line</p><p class="footer-prompt">Have a difficult data question?</p></div>
      <a class="footer-email" href={`mailto:${site.email}`} data-event="email_click" data-event-label="footer">{site.email}<Icon name="arrow-up-right" /></a>
    </div>}
    <div class="container footer-grid">
      <ul class="footer-links">{nav.map(([label,href]) => <li><a href={href}>{label}</a></li>)}</ul>
      <ul class="footer-links footer-social" aria-label="Social links">{social.map(([label,href,icon]) => <li><a href={href} target="_blank" rel="noopener noreferrer" data-event={label==='LinkedIn'?'linkedin_click':undefined} data-event-label="footer"><Icon name={icon} size="1.15em" /><span>{label}</span></a></li>)}</ul>
      <p class="footer-meta"><span>{site.location}</span><span>Data Analyst</span><span>© {new Date().getFullYear()} {site.name}</span></p>
    </div>
  </footer>
  <script is:inline define:vars={{ gaMeasurementId }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
    if (gaMeasurementId) { window.gtag('js', new Date()); window.gtag('config', gaMeasurementId, { anonymize_ip: true }); }
    window.portfolioAnalytics = window.portfolioAnalytics || { track: function(name, detail) { var payload = detail || {}; if (gaMeasurementId) window.gtag('event', name, payload); window.dispatchEvent(new CustomEvent('portfolio:analytics', { detail: { name: name, ...payload } })); } };
    document.addEventListener('click', function(event) {
      var el = event.target.closest('a,button'); if (!el) return;
      var name = el.dataset.event;
      if (!name && el.matches('a[href^="/work/"]')) name = 'project_card_click';
      if (!name && el.matches('a[href$="Farih-Muwaffaq-Resume.pdf"]')) name = 'resume_download';
      if (!name && el.matches('a[href^="mailto:"]')) name = 'email_click';
      if (!name && el.matches('a[href*="linkedin.com"]')) name = 'linkedin_click';
      if (name) window.portfolioAnalytics.track(name, { label: el.dataset.eventLabel || el.getAttribute('href') || el.textContent.trim() });
    });
  </script>
  <script is:inline src="/js/animations.js" defer></script>
</body>
</html>
