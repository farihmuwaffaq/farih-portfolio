---
import Icon from './Icon.astro';

type DeckLibraryData = NonNullable<import('astro:content').CollectionEntry<'work'>['data']['deckLibrary']>;
interface Props { library: DeckLibraryData }
const { library } = Astro.props;
---

<section class="section deck-library" aria-labelledby="deck-library-title">
  <div class="deck-library-intro">
    <div><p class="eyebrow">Selected client reporting</p><h2 id="deck-library-title">Evidence in the room.</h2></div>
    <div class="deck-library-proof"><strong>{library.totalProduced}</strong><span>Decks & reports led</span><p>{library.ownership}. {library.description}</p></div>
  </div>
  <div class="deck-library-grid">
    {library.items.map((deck, index) => (
      <article class="deck-card">
        <span class="deck-card-media">
          <img src={deck.thumbnail} alt={deck.thumbnailAlt} width="1280" height="720" loading="lazy" />
          <span class="deck-card-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="deck-card-view" aria-hidden="true">Preview deck <Icon name="arrow-right" /></span>
        </span>
        <div class="deck-card-body">
          <p class="deck-card-meta"><span>{deck.client}</span><span>{deck.cadence}</span><span>{deck.year}</span></p>
          <h3>{deck.title}</h3>
        </div>
        <button class="deck-card-trigger" type="button" data-deck-open data-document-id={deck.documentId} data-deck-title={deck.title} aria-label={`Preview ${deck.title}`}></button>
      </article>
    ))}
  </div>
  <p class="deck-library-disclosure">Preview loads from Google Slides only after interaction and remains inside this website.</p>
</section>

<dialog class="deck-preview" data-deck-dialog aria-labelledby="deck-preview-title" aria-describedby="deck-preview-note">
  <div class="deck-preview-shell">
    <header class="deck-preview-header"><div><p class="eyebrow">Public client work</p><h2 id="deck-preview-title" data-deck-dialog-title>Deck preview</h2></div><button class="deck-preview-close" type="button" data-deck-close aria-label="Close deck preview"><Icon name="x" /></button></header>
    <div class="deck-preview-frame"><p class="deck-preview-status" data-deck-status role="status">Loading Google Slides preview...</p><iframe data-deck-frame title="Google Slides deck preview" allowfullscreen referrerpolicy="no-referrer"></iframe></div>
    <footer class="deck-preview-footer"><p id="deck-preview-note">This preview is served by Google. Close this window and try again if the embed is unavailable.</p></footer>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-deck-dialog]');
  let frame = dialog?.querySelector<HTMLIFrameElement>('[data-deck-frame]');
  const title = dialog?.querySelector<HTMLElement>('[data-deck-dialog-title]');
  const status = dialog?.querySelector<HTMLElement>('[data-deck-status]');
  let trigger: HTMLButtonElement | null = null;
  let loadTimer = 0;
  let activePreviewUrl = '';
  const track = (event: string, label: string) => window.portfolioAnalytics?.track(event, { label });
  const closePreview = () => dialog?.close();

  document.querySelectorAll<HTMLButtonElement>('[data-deck-open]').forEach(button => button.addEventListener('click', () => {
    if (!dialog || !frame || !title || !status) return;
    const documentId = button.dataset.documentId;
    const deckTitle = button.dataset.deckTitle || 'Deck preview';
    if (!documentId) return;
    trigger = button;
    title.textContent = deckTitle;
    frame.title = `${deckTitle} — Google Slides preview`;
    status.textContent = 'Loading Google Slides preview...';
    status.hidden = false;
    dialog.showModal();
    activePreviewUrl = `https://docs.google.com/presentation/d/${documentId}/preview`;
    frame.src = activePreviewUrl;
    track('deck_preview_open', deckTitle);
    window.clearTimeout(loadTimer);
    loadTimer = window.setTimeout(() => {
      if (!status.hidden) {
        status.textContent = 'Preview is taking longer than expected. Close this window and try again.';
        track('deck_preview_error', deckTitle);
      }
    }, 12000);
  }));

  const bindFrameLoad = () => {
    const boundFrame = frame;
    boundFrame?.addEventListener('load', event => {
      if (event.currentTarget !== boundFrame || boundFrame !== frame || !dialog?.open || !activePreviewUrl || boundFrame.src !== activePreviewUrl) return;
      window.clearTimeout(loadTimer);
      if (status) status.hidden = true;
    });
  };
  bindFrameLoad();
  dialog?.querySelector<HTMLButtonElement>('[data-deck-close]')?.addEventListener('click', closePreview);
  dialog?.addEventListener('click', event => { if (event.target === dialog) closePreview(); });
  dialog?.addEventListener('close', () => {
    window.clearTimeout(loadTimer);
    const deckTitle = title?.textContent || 'Deck preview';
    activePreviewUrl = '';
    if (frame) {
      const cleanFrame = frame.cloneNode(false) as HTMLIFrameElement;
      cleanFrame.removeAttribute('src');
      frame.replaceWith(cleanFrame);
      frame = cleanFrame;
      bindFrameLoad();
    }
    track('deck_preview_close', deckTitle);
    trigger?.focus();
    trigger = null;
  });
</script>
