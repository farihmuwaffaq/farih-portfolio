---
import Icon from './Icon.astro';
const { id, src, alt, caption } = Astro.props;
---
<button class="placeholder-button" type="button" data-lightbox-open={id} aria-label={`Enlarge ${caption}`}><img src={src} alt={alt} width="800" height="450" loading="lazy" /><strong><Icon name="zoom-in" />{caption}</strong></button>
<dialog class="lightbox" id={id} aria-label={caption}><button class="lightbox-close" type="button" aria-label="Close"><Icon name="x" /></button><div class="lightbox-inner"><figure><img src={src} alt={alt} /><figcaption>{caption}</figcaption></figure></div></dialog>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach(open=>open.addEventListener('click',()=>{const dialog=document.querySelector<HTMLDialogElement>(`#${open.dataset.lightboxOpen}`);if(dialog){dialog.dataset.trigger=open.dataset.lightboxOpen;dialog.showModal();}}));
  document.querySelectorAll<HTMLDialogElement>('.lightbox').forEach(dialog=>{const close=()=>dialog.close();dialog.querySelector<HTMLButtonElement>('.lightbox-close')?.addEventListener('click',close);dialog.addEventListener('click',event=>{if(event.target===dialog)close();});dialog.addEventListener('close',()=>document.querySelector<HTMLButtonElement>(`[data-lightbox-open="${dialog.dataset.trigger}"]`)?.focus());});
</script>
