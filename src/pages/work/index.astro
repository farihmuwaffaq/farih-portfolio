---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
const order=['analytics-automation','nexus-bi-platform','shopee-pricing-tracker','healthtech-data-infrastructure','lifepack-delivery-margin-analysis','fmcg-operations-analytics','loan-default-model','retail-sales-datamart','carbon-methodology-assessment'];
const projects=(await getCollection('work')).sort((a,b)=>order.indexOf(a.data.slug)-order.indexOf(b.data.slug));
const labs=[['AdventureWorks Sales Report','Power BI · sample/training data','Revenue, profit, orders, returns, category and customer analysis.','/images/lab/adventureworks.png'],['Maven Cycles Report','Power BI · sample/training data','Product, geography, period and profit analysis.','/images/lab/maven-cycles.png'],['UNIX-O Sales Dashboard','Excel · sample/training data','Sales, profit, marketplace, rating and product analysis.','/images/lab/unix-o-dashboard.png'],['Couture28 Sales Dashboard','Excel · sample/training data','Structured cleaning, pivot analysis and interactive dashboarding.','/images/lab/couture28-dashboard.png'],['Kimia Farma Sales Dashboard','Looker Studio · project-based internship','Invoices, sales, product volume, customers and purchasing trends.','/images/lab/kimia-farma-dashboard.jpg'],['Maleo Social Media Analytics Pipeline','ClickHouse · Metricool · Looker · N8N · real architecture','Production pipeline from multi-platform performance data to dashboards and AI-assisted daily nudges. No client performance data.','/images/lab/maleo-pipeline-architecture.png']];
---
<BaseLayout title="Data Analytics Work | Farih Muwaffaq" description="Case studies in analytics automation, business intelligence, commercial operations, machine learning, and sustainability by Farih Muwaffaq." animate={true}>
  <section class="section case-hero"><div class="container">
    <div class="section-heading"><div><p class="eyebrow rise"><span class="idx">Index</span> {projects.length} case studies · {labs.length} lab studies</p><h1 class="rise rise-1">Work with evidence.</h1></div><p class="lede rise rise-2">Analytics systems, models, and decision tools. Professional work protects confidential data; project exercises remain clearly labeled.</p></div>
    <div class="work-list-heading"><p class="eyebrow"><span class="idx">01</span> Selected systems</p><p>Professional and project-based systems with explicit role, evidence, and decision context.</p></div>
    <ProjectGrid projects={projects} filters={true} featuredSlug="lifepack-delivery-margin-analysis" />
  </div></section>
  <section class="section" id="dashboard-lab"><div class="container">
    <div class="section-heading"><div><p class="eyebrow"><span class="idx">02</span> Dashboard Lab</p><h2>Focused interface studies.</h2></div><p>Independent exercises using sample or training data. Gallery items, not client results or standalone case studies.</p></div>
    <div class="study-grid">{labs.map((lab,i)=><article class="study-card"><Lightbox id={`lab-${i}`} src={lab[3]} alt={lab[0]} caption={lab[0]} /><div class="study-body"><p class="eyebrow">{lab[1]}</p><h3>{lab[0]}</h3><p>{lab[2]}</p></div></article>)}</div>
  </div></section>
</BaseLayout>
