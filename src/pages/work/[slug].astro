---
import { getCollection, render } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
export async function getStaticPaths(){const projects=await getCollection('work');return projects.map(project=>({params:{slug:project.data.slug},props:{project}}));}
const { project }=Astro.props;
const { Content }=await render(project);
---
<CaseStudyLayout project={project}><Content /></CaseStudyLayout>
