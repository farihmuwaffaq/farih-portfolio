---
import BaseLayout from '../layouts/BaseLayout.astro';
const endpoint=import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT || '';
---
<BaseLayout title="Contact Farih Muwaffaq | Data Analyst" description="Contact Farih Muwaffaq about data analytics, business intelligence, commercial performance, and automation-focused roles or collaborations.">
<section class="section"><div class="container grid two"><div><p class="eyebrow">Contact</p><h1>Let's turn a data question into a useful system.</h1><p class="lede">I am open to conversations about analytics, business intelligence, commercial performance, and automation-focused roles or collaborations.</p><p><strong>Email</strong><br /><a href="mailto:farihmuwaffaq@gmail.com" data-event="click_email">farihmuwaffaq@gmail.com</a></p><p><strong>Location</strong><br />Jakarta, Indonesia</p><p class="notice"><strong>LinkedIn:</strong> URL pending confirmation; no non-functional external link is published.</p><p><small>Privacy: form details are used only to respond to your inquiry. No external analytics or form provider is active without configuration, and message content is never sent to analytics.</small></p></div><div class="card"><h2>Send a message</h2><form id="contact-form" data-endpoint={endpoint} novalidate><div class="form-grid"><label class="field">Name<input name="name" autocomplete="name" required /></label><label class="field">Work email<input type="email" name="email" autocomplete="email" required /></label><label class="field full">Company <span class="sr-only">(optional)</span><input name="company" autocomplete="organization" /></label><label class="field full">Reason for contacting<select name="reason" required><option value="">Select one</option><option>Role opportunity</option><option>Analytics collaboration</option><option>Portfolio question</option><option>Other</option></select></label><label class="field full">Message<textarea name="message" required minlength="20"></textarea></label><label class="field full"><span><input type="checkbox" name="consent" required /> I consent to this information being used to respond to my inquiry.</span></label><div class="field full sr-only" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div></div><button class="button" type="submit">Send message</button><p class="status" id="form-status" role="status" aria-live="polite"></p></form></div></div></section>
<script is:inline define:vars={{ endpoint }}>
  const form=document.querySelector('#contact-form'); const status=document.querySelector('#form-status');
  form?.addEventListener('submit',async(event)=>{event.preventDefault(); status.textContent=''; if(!form.checkValidity()){form.reportValidity(); status.textContent='Please complete the required fields.'; return;} const data=new FormData(form); if(data.get('website')) return; const button=form.querySelector('button[type="submit"]'); button.disabled=true; button.textContent='Sending…';
    if(!endpoint){status.textContent='Demo mode: the form is not connected yet. Please email Farih directly.'; button.disabled=false; button.textContent='Send message'; window.portfolioAnalytics?.track('submit_contact', { state: 'demo' }); return;}
    try{const response=await fetch(endpoint,{method:'POST',body:data,headers:{Accept:'application/json'}}); if(!response.ok) throw new Error(); form.reset(); status.textContent='Thank you. Your message has been sent.'; window.portfolioAnalytics?.track('submit_contact', { state: 'success' });}
    catch{status.textContent='The message could not be sent. Please use the email link instead.'; window.portfolioAnalytics?.track('contact_error');}
    finally{button.disabled=false;button.textContent='Send message';}
  });
</script>
</BaseLayout>
