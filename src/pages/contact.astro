---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
const endpoint=import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT || '';
---
<BaseLayout title="Contact Farih Muwaffaq | Data Analyst" description="Contact Farih Muwaffaq about data analytics, business intelligence, commercial performance, and automation-focused roles or collaborations." footerVariant="compact">
<section class="section case-hero contact-page"><div class="container grid two contact-grid">
  <div>
    <p class="eyebrow rise"><span class="idx">Signal</span> Contact</p>
    <h1 class="rise rise-1">Let's turn a data question into a useful system.</h1>
    <p class="lede rise rise-2">I am open to conversations about analytics, business intelligence, commercial operations, data quality, and automation-focused roles or collaborations.</p>
    <dl class="spec rise rise-3">
      <div class="spec-row"><dt>Email</dt><dd><a class="contact-link" href="mailto:farihmuwaffaq@gmail.com" data-event="contact_email"><Icon name="mail" />farihmuwaffaq@gmail.com</a></dd></div>
      <div class="spec-row"><dt>LinkedIn</dt><dd><a class="contact-link" href="https://www.linkedin.com/in/farihmuwaffaq/" data-event="contact_linkedin"><Icon name="logo-linkedin" size="1em" />linkedin.com/in/farihmuwaffaq</a></dd></div>
      <div class="spec-row"><dt>GitHub</dt><dd><a class="contact-link" href="https://github.com/farihmuwaffaq" data-event="contact_github"><Icon name="logo-github" size="1em" />github.com/farihmuwaffaq</a></dd></div>
      <div class="spec-row"><dt>Location</dt><dd>Jakarta, Indonesia · open to relocation · remote-friendly</dd></div>
    </dl>
  </div>
  {endpoint ? <form class="contact-form" id="message-form" data-endpoint={endpoint} novalidate>
    <p class="mono" style="margin:0">Message form</p>
    <div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div>
    <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
    <div class="field"><label for="message">Message</label><textarea id="message" name="message" required minlength="20"></textarea></div>
    <div class="field honeypot"><label for="company">Company</label><input id="company" name="company" tabindex="-1" autocomplete="off" /></div>
    <button class="button" type="submit"><span class="btn-label">Send message</span><Icon name="arrow-right" /></button>
    <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
  </form> : <aside class="contact-form contact-direct" id="message-form"><p class="mono">Direct message</p><h2>Email works best.</h2><p>Share the question, context, and expected outcome. I will reply as soon as I can.</p><a class="button" href="mailto:farihmuwaffaq@gmail.com?subject=Data%20conversation"><span>Write an email</span><Icon name="arrow-right" /></a><a class="contact-link" href="https://www.linkedin.com/in/farihmuwaffaq/" target="_blank" rel="noopener noreferrer">Or connect on LinkedIn<Icon name="arrow-up-right" /></a></aside>}
</div></section>
<script>
  const form=document.querySelector<HTMLFormElement>('form#message-form');
  const status=document.querySelector<HTMLElement>('#form-status');
  form?.addEventListener('submit', async event=>{
    event.preventDefault();
    const data=new FormData(form);
    if(data.get('company')) return;
    if(!form.reportValidity()) return;
    const endpoint=form.dataset.endpoint||'';
    const button=form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if(!endpoint){status!.textContent='The form endpoint is not configured. Please use the email link instead.';return;}
    button!.disabled=true;const label=button!.querySelector('.btn-label');label!.textContent='Sending…';
    try{
      const response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(data))});
      if(!response.ok) throw new Error('request failed');
      status!.textContent='Message sent. I usually reply within one business day.';
      form.reset();window.portfolioAnalytics?.track('contact_submit',{state:'success'});
    }
    catch{status!.textContent='The message could not be sent. Please use the email link instead.';window.portfolioAnalytics?.track('contact_error');}
    finally{button!.disabled=false;label!.textContent='Send message';}
  });
</script>
</BaseLayout>
