---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
const projects = (await getCollection('work')).filter(p=>p.data.featured).sort((a,b)=>['analytics-automation','nexus-bi-platform','loan-default-model'].indexOf(a.data.slug)-['analytics-automation','nexus-bi-platform','loan-default-model'].indexOf(b.data.slug));
const heroProof: Record<string, string> = {'analytics-automation':'Four-brand pipeline','nexus-bi-platform':'BigQuery BI platform · RBAC','loan-default-model':'AUC 0.857 / KS 0.57'};
const person = {'@context':'https://schema.org','@type':'Person',name:'Farih Muwaffaq',jobTitle:'Data Analyst',address:{'@type':'PostalAddress',addressLocality:'Jakarta',addressCountry:'ID'},knowsAbout:['Analytics automation','Business intelligence','Commercial analytics','Data pipelines']};
const capabilities = [['Analytics systems','Reliable data flows connecting fragmented business data.'],['Automation','Repeatable reporting, alerts, and updates removing manual steps.'],['Business intelligence','Decision-ready dashboards built around stakeholder questions.'],['Commercial analysis','Inventory, pricing, and performance analysis ending in action.']];
---
<BaseLayout title="Farih Muwaffaq | Data Analyst & Analytics Automation" jsonLd={person} animate={true}>
  <section class="hero home-hero"><div class="container hero-layout">
    <div class="hero-copy"><p class="eyebrow rise"><span class="idx">00</span> Data systems · Commercial intelligence</p><h1 class="rise rise-1">Data, made decisive.</h1><p class="lede rise rise-2">I build analytics systems that move teams from raw signals to trusted, repeatable business decisions.</p><div class="actions rise rise-3"><a class="button" href="/work">Explore selected work<Icon name="arrow-up-right" /></a><a class="button secondary" href="/about">How I work<Icon name="arrow-right" /></a></div><p class="proof-line rise rise-4"><span><b>Experience</b> SKINTIFIC · Maleo · Lifepack.id · FMCG operations</span></p></div>
    <aside class="surface hero-cockpit rise rise-2"><div class="surface-core cockpit-core"><p class="availability">Jakarta · Open to high-impact data roles</p><div class="metric-stack"><div class="metric"><strong>1,567%</strong><span>Production capacity growth supported</span></div><div class="metric"><strong>10+</strong><span>Operational dashboards and reports</span></div><div class="metric"><strong>04</strong><span>Brands in one reporting pipeline</span></div></div></div></aside>
  </div></section>
  <section class="section" data-reveal><div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="idx">01</span> Selected work</p><h2>Systems built around decisions.</h2></div><p>Selected analytics systems spanning governed BI, automated reporting, and predictive modeling.</p></div><div class="work-bento">{projects.map((p,i)=><article class="card project"><div class="card-core project-core"><div class="project-head"><span class="mono">{String(i+1).padStart(2,'0')} / {p.data.organization}</span><span class="status">{p.data.evidenceType}</span></div><div class="project-media"><img src={p.data.coverImage} alt={p.data.coverAlt} width="800" height="450" loading={i===0?'eager':'lazy'} /></div><div class="project-body"><div><p class="eyebrow">{p.data.industry}</p><h3>{p.data.title}</h3><p>{p.data.summary}</p></div><a class="card-link" href={`/work/${p.data.slug}`} aria-label={`Read ${p.data.title}`}><Icon name="arrow-up-right" /></a><div class="project-meta"><span class="mono">{heroProof[p.data.slug]}</span></div></div></div></article>)}</div><div class="actions" style="margin-top:2rem"><a class="button secondary" href="/work">See all case studies<Icon name="arrow-right" /></a></div></div></section>
  <section class="section" data-reveal><div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="idx">02</span> Capabilities</p><h2>From infrastructure to action.</h2></div><p>Technical delivery stays connected to decision context, ownership, and measurable use.</p></div><dl class="defs">{capabilities.map(([term,def],i)=><div class="resume-item"><dt><span class="mono idx">{String(i+1).padStart(2,'0')}</span><h3>{term}</h3></dt><dd>{def}</dd></div>)}</dl></div></section>
  <section class="section" data-reveal><div class="container grid two"><div><p class="eyebrow"><span class="idx">03</span> Current focus</p><h2>Commercial and inventory intelligence.</h2></div><div><p class="lede">At SKINTIFIC, I support inventory and commercial analytics across brands and channels: stock health, pricing parity, NPD, critical SKU, and promotional analysis.</p><p class="quiet">Public descriptions remain high-level to protect confidential operating data.</p></div></div></section>
  <section class="section" data-reveal><div class="container"><p class="eyebrow"><span class="idx">04</span> Contact</p><h2 style="max-width:15ch">Need an analyst who connects systems to decisions?</h2><p class="lede">Open to conversations about analytics, business intelligence, commercial performance, and automation.</p><div class="actions"><a class="button" href="/contact">Contact Farih<Icon name="arrow-up-right" /></a><a class="button secondary" href="/Farih-Muwaffaq-Resume.pdf" download="Farih-Muwaffaq-Resume.pdf">Download resume<Icon name="download" /></a></div></div></section>
</BaseLayout>
