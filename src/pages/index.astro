---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
const projects = (await getCollection('work')).filter(p=>p.data.featured).sort((a,b)=>['analytics-automation','healthtech-data-infrastructure','loan-default-model'].indexOf(a.data.slug)-['analytics-automation','healthtech-data-infrastructure','loan-default-model'].indexOf(b.data.slug));
const person = {'@context':'https://schema.org','@type':'Person',name:'Farih Muwaffaq',jobTitle:'Data Analyst',address:{'@type':'PostalAddress',addressLocality:'Jakarta',addressCountry:'ID'},knowsAbout:['Analytics automation','Business intelligence','Commercial analytics','Data pipelines']};
---
<BaseLayout title="Farih Muwaffaq | Data Analyst & Analytics Automation" jsonLd={person}>
  <section class="section"><div class="container hero"><div><p class="eyebrow">Data Analyst · Analytics Automation · Business Intelligence</p><h1>I build data systems that move teams from reporting to action.</h1><p class="lede">I am Farih Muwaffaq, a Jakarta-based Data Analyst working across FMCG, healthcare, and marketing analytics. I turn fragmented data into reliable pipelines, dashboards, alerts, and business recommendations.</p><div class="actions"><a class="button" href="/work">View selected work</a><a class="button secondary" href="/resume" data-event="download_resume">Download resume</a><a href="/contact">Contact me</a></div></div><div class="hero-mark" aria-hidden="true">FM</div></div></section>
  <section class="section-sm"><div class="container notice">Experience across SKINTIFIC, Future Creative Network, Lifepack.id, FMCG operations, and project-based analytics for Kimia Farma and ID/X Partners.</div></section>
  <section class="section"><div class="container"><p class="eyebrow">Selected work</p><h2>Systems built around decisions</h2><ProjectGrid projects={projects} /><div class="actions"><a class="button secondary" href="/work">See all case studies</a></div></div></section>
  <section class="section"><div class="container"><p class="eyebrow">Capabilities</p><div class="grid capability-grid"><article class="card"><h3>Analytics systems</h3><p>Reliable data flows that connect, clean, and maintain fragmented business data.</p></article><article class="card"><h3>Automation</h3><p>Repeatable reporting, alerts, and updates that reduce manual operating steps.</p></article><article class="card"><h3>Business intelligence</h3><p>Decision-ready dashboards and KPI structures designed around stakeholder questions.</p></article><article class="card"><h3>Commercial and operational analysis</h3><p>Analysis framed around inventory, performance, pricing, and business action.</p></article></div></div></section>
  <section class="section"><div class="container grid two"><div><p class="eyebrow">Current focus</p><h2>Commercial and inventory analytics</h2></div><p>At SKINTIFIC, I support inventory and commercial analytics across multiple brands and channels, including stock health, slow-moving inventory, pricing parity, NPD monitoring, critical SKU tracking, and promotional analysis. Public descriptions remain high-level to protect confidential operating data.</p></div></section>
  <section class="section"><div class="container card"><h2>Need an analyst who connects systems to decisions?</h2><p class="lede">I am open to conversations about data analytics, business intelligence, commercial analytics, and analytics automation.</p><div class="actions"><a class="button" href="/contact">Contact Farih</a><a class="button secondary" href="/resume">View resume</a></div></div></section>
</BaseLayout>
