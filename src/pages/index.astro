---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
const projects = (await getCollection('work')).filter(p=>p.data.featured).sort((a,b)=>['analytics-automation','nexus-bi-platform','loan-default-model'].indexOf(a.data.slug)-['analytics-automation','nexus-bi-platform','loan-default-model'].indexOf(b.data.slug));
const heroProof: Record<string, string> = {'analytics-automation':'Four-brand pipeline','nexus-bi-platform':'BigQuery BI platform · RBAC','loan-default-model':'AUC 0.857 / KS 0.57'};
const person = {'@context':'https://schema.org','@type':'Person',name:'Farih Muwaffaq',jobTitle:'Data Analyst',address:{'@type':'PostalAddress',addressLocality:'Jakarta',addressCountry:'ID'},knowsAbout:['Analytics automation','Business intelligence','Commercial analytics','Data pipelines']};
const capabilities = [
  { stage: 'Ingest', term: 'Analytics systems', definition: 'Reliable data flows connecting fragmented business data.', tools: ['SQL', 'BigQuery', 'PostgreSQL'] },
  { stage: 'Govern', term: 'Automation', definition: 'Repeatable reporting, alerts, and updates removing manual steps.', tools: ['Apps Script', 'REST APIs', 'Git'] },
  { stage: 'Model', term: 'Business intelligence', definition: 'Decision-ready dashboards built around stakeholder questions.', tools: ['Python', 'Pandas', 'Excel'] },
  { stage: 'Decide', term: 'Commercial analysis', definition: 'Inventory, pricing, and performance analysis ending in action.', tools: ['Power BI', 'Tableau', 'Looker Studio'] }
];
const commercialInputs=[['brand','Brands','Portfolio · SKU · category performance','Portfolio health'],['channel','Channels','Online · MT · GT performance','Channel performance'],['stock','Stock','Availability · weeks of inventory · OOS risk','Inventory risk'],['price','Pricing','SRP · discount depth · channel gap','Price health'],['npd','NPD','Launch · distribution · sell-through','Launch health']];
---
<BaseLayout title="Farih Muwaffaq | Data Analyst & Analytics Automation" jsonLd={person} animate={true}>
  <section class="hero home-hero"><div class="container hero-layout">
    <div class="hero-copy"><p class="eyebrow rise"><span class="idx">00</span> Data systems · Commercial intelligence</p><h1 class="rise rise-1">Data, made decisive.</h1><p class="lede rise rise-2">I build analytics systems that move teams from raw signals to trusted, repeatable business decisions.</p><div class="actions rise rise-3"><a class="button" href="/work">Explore selected work<Icon name="arrow-up-right" /></a><a class="button secondary" href="/about">How I work<Icon name="arrow-right" /></a></div><p class="proof-line rise rise-4"><span><b>Experience</b> SKINTIFIC · Maleo · Lifepack.id · FMCG operations</span></p></div>
    <aside class="surface hero-cockpit rise rise-2 system-boot" data-system-boot><div class="surface-core cockpit-core"><div class="cockpit-header"><p class="availability">Operating layer · Jakarta</p><span class="mono">FM / 26</span></div><div class="signal-chart" aria-hidden="true"><svg viewBox="0 0 440 120" preserveAspectRatio="none"><path class="signal-grid" d="M0 24H440M0 60H440M0 96H440M88 0V120M176 0V120M264 0V120M352 0V120"/><path class="signal-area" d="M0 104L55 96L110 101L165 72L220 78L275 49L330 58L385 22L440 30V120H0Z"/><path class="signal-path" pathLength="1" d="M0 104L55 96L110 101L165 72L220 78L275 49L330 58L385 22L440 30"/><circle cx="385" cy="22" r="4"/></svg><span>Decision signal / normalized</span></div><div class="metric-stack"><div class="metric"><strong data-count-to="1567" data-count-suffix="%">1,567%</strong><span>Production capacity growth supported</span></div><div class="metric"><strong data-count-to="10" data-count-suffix="+">10+</strong><span>Operational dashboards and reports</span></div><div class="metric"><strong data-count-to="4" data-count-pad="2">04</strong><span>Brands in one reporting pipeline</span></div></div><div class="cockpit-footer"><span>Pipeline health</span><strong>Stable</strong><i></i></div></div></aside>
  </div></section>
  <section class="section work-zone" data-reveal><div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="idx">01</span> Selected work</p><h2>Systems built around decisions.</h2></div><p>Selected analytics systems spanning governed BI, automated reporting, and predictive modeling.</p></div><div class="work-bento">{projects.map((p,i)=><article class="card project"><div class="card-core project-core"><div class="project-head"><span class="mono">{String(i+1).padStart(2,'0')} / {p.data.organization}</span><span class="status">{p.data.evidenceType}</span></div><div class="project-media"><img src={p.data.coverImage} alt={p.data.coverAlt} width="800" height="450" loading={i===0?'eager':'lazy'} /></div><div class="project-body"><div><p class="eyebrow">{p.data.industry}</p><h3>{p.data.title}</h3><p>{p.data.summary}</p></div><a class="card-link" href={`/work/${p.data.slug}`} aria-label={`Read ${p.data.title}`}><Icon name="arrow-up-right" /></a><div class="project-meta"><span class="mono">{heroProof[p.data.slug]}</span></div></div></div></article>)}</div><div class="work-index-link"><span class="mono">03 selected / 09 total</span><a class="button secondary" href="/work">See all case studies<Icon name="arrow-right" /></a></div></div></section>
  <section class="section capability-zone" data-reveal data-operating-model><div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="idx">02</span> Operating model</p><h2>From infrastructure to action.</h2></div><p>Technical delivery stays connected to decision context, ownership, and measurable use.</p></div><div class="capability-map" role="list" aria-label="Analytics operating model"><div class="capability-line" aria-hidden="true"></div>{capabilities.map(({stage,term,definition,tools},i)=><article class="capability-step" role="listitem" tabindex="0" data-capability-step data-step={i+1}><div class="capability-node"><span>{String(i+1).padStart(2,'0')}</span></div><p class="mono">{stage}</p><h3>{term}</h3><p>{definition}</p><ul class="capability-tools" aria-label={`Tools used for ${stage}`}>{tools.map(tool=><li>{tool}</li>)}</ul></article>)}</div></div></section>
  <section class="section focus-zone" data-reveal><div class="container focus-layout"><div class="focus-copy"><p class="eyebrow"><span class="idx">03</span> Current focus</p><h2>Commercial and inventory intelligence.</h2><p class="lede">At SKINTIFIC, I support inventory and commercial analytics across brands and channels: stock health, pricing parity, NPD, critical SKU, and promotional analysis.</p><p class="quiet">Public descriptions remain high-level to protect confidential operating data.</p></div><div class="surface focus-system" data-commercial-system><div class="surface-core focus-core"><div class="focus-orbit"><button class="focus-center" type="button" data-commercial-reset aria-label="Reset commercial health view"><span data-center-kicker>Decision system</span><strong data-center-title>Commercial<br/>health</strong><small data-center-detail>Signal → context → action</small></button>{commercialInputs.map(([key,label,detail,title])=><button class={`orbit-item orbit-${key}`} type="button" data-commercial-node={key} data-title={title} data-detail={detail} aria-pressed="false">{label}</button>)}<svg viewBox="0 0 600 430" aria-hidden="true"><path data-connector="brand" d="M300 215L118 95"/><path data-connector="channel" d="M300 215L487 86"/><path data-connector="stock" d="M300 215L512 316"/><path data-connector="price" d="M300 215L116 337"/><path data-connector="npd" d="M300 215L300 38"/></svg></div><p class="sr-only" aria-live="polite" data-commercial-live>Commercial health decision system.</p><div class="focus-readout"><span><i></i> Governed inputs</span><span data-focus-status>Choose an input to inspect</span></div></div></div></div></section>
  <section class="section contact-zone" data-reveal><div class="container closing-layout"><div><p class="eyebrow"><span class="idx">04</span> Contact</p><h2>Need an analyst who connects systems to decisions?</h2></div><div class="closing-action"><p class="lede">Open to conversations about analytics, business intelligence, commercial performance, and automation.</p><div class="actions"><a class="button" href="/contact">Contact Farih<Icon name="arrow-up-right" /></a><a class="button secondary" href="/Farih-Muwaffaq-Resume.pdf" download="Farih-Muwaffaq-Resume.pdf">Download resume<Icon name="download" /></a></div><p class="availability">Available for high-impact data roles</p></div></div></section>
</BaseLayout>
