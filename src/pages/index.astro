---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
const projects = (await getCollection('work')).filter(p=>p.data.featured).sort((a,b)=>['analytics-automation','nexus-bi-platform','loan-default-model'].indexOf(a.data.slug)-['analytics-automation','nexus-bi-platform','loan-default-model'].indexOf(b.data.slug));
const heroProof: Record<string, string> = {'analytics-automation':'Four-brand pipeline','nexus-bi-platform':'BigQuery BI platform · RBAC','loan-default-model':'AUC 0.857 / KS 0.57'};
const allProjects = await getCollection('work');
const totalProjects = allProjects.length;
const uniqueOrgs = new Set(allProjects.map(p=>p.data.organization)).size;
const uniqueDomains = new Set(allProjects.flatMap(p=>p.data.categories)).size;
const totalTouchpoints = 5 + 16; // workplaceLogos + clientLogos
const impactMetric = '1567'; // Gajahpangan production capacity growth
const person = {'@context':'https://schema.org','@type':'Person',name:'Farih Muwaffaq',jobTitle:'Data Analyst',address:{'@type':'PostalAddress',addressLocality:'Jakarta',addressCountry:'ID'},knowsAbout:['Analytics automation','Business intelligence','Commercial analytics','Data pipelines']};
const capabilities = [
  { stage: 'Ingest', term: 'Analytics systems', definition: 'Reliable data flows connecting fragmented business data.', tools: ['SQL', 'BigQuery', 'PostgreSQL'] },
  { stage: 'Govern', term: 'Automation', definition: 'Repeatable reporting, alerts, and updates removing manual steps.', tools: ['Apps Script', 'REST APIs', 'Git'] },
  { stage: 'Model', term: 'Business intelligence', definition: 'Decision-ready dashboards built around stakeholder questions.', tools: ['Python', 'Pandas', 'Excel'] },
  { stage: 'Decide', term: 'Commercial analysis', definition: 'Inventory, pricing, and performance analysis ending in action.', tools: ['Power BI', 'Tableau', 'Looker Studio'] }
];
const commercialInputs=[['brand','Brands','Portfolio · SKU · category performance','Portfolio health'],['channel','Channels','Online · MT · GT performance','Channel performance'],['stock','Stock','Availability · weeks of inventory · OOS risk','Inventory risk'],['price','Pricing','SRP · discount depth · channel gap','Price health'],['npd','NPD','Launch · distribution · sell-through','Launch health']];
const workplaceLogos = [
  { name:'Selasar Kampus', file:'selasar-kampus.svg', role:'Founder & CEO', years:'2021–23', summary:'Founded a campus marketplace; built the early analytics and ops backbone.', type:'compact', tone:'color' },
  { name:'Gajahpangan', file:'gajahpangan.svg', role:'Data Analyst', years:'2024', summary:'Built commercial reporting and inventory analytics for the F&B distribution business.', type:'combination', tone:'color' },
  { name:'Lifepack', file:'lifepack.svg', role:'Data Analyst', years:'2024–25', summary:'Shipped pharmacy retail dashboards and automated recurring reporting.', type:'compact', tone:'color' },
  { name:'Maleo', file:'maleo.svg', role:'Data Analyst', years:'2025–26', summary:'Delivered brand and campaign analytics across agency client portfolios.', type:'wordmark', tone:'color' },
  { name:'SKINTIFIC', file:'skintific.svg', role:'Senior Associate Data Analyst', years:'2026–Now', summary:'Own the governed BI semantic layer, RBAC, and commercial monitoring.', type:'combination', tone:'color' },
];
const clientLogos = [
  { name:'Blue Band', file:'blue-band.svg', context:'Campaign monitoring', type:'wordmark', tone:'color' },
  { name:'CeraVe', file:'cerave.svg', context:'Retail analytics', type:'combination', tone:'color' },
  { name:'Chocopie', file:'chocopie.svg', context:'Commercial analysis', type:'wordmark', tone:'color' },
  { name:'Concerto', file:'concerto.svg', context:'Brand analytics', type:'combination', tone:'color' },
  { name:'Garnier', file:'garnier.svg', context:'Campaign monitoring', type:'wordmark', tone:'mono' },
  { name:'Garuda Indonesia', file:'garuda-indonesia.svg', context:'Commercial analysis', type:'compact', tone:'color' },
  { name:'Head & Shoulders', file:'head-and-shoulders.svg', context:'Campaign monitoring', type:'combination', tone:'mono' },
  { name:'Hyundai', file:'hyundai.svg', context:'Brand analytics', type:'wordmark', tone:'mono' },
  { name:'ID/X Partners', file:'idx-partners.svg', context:'Consulting project', type:'wordmark', tone:'color' },
  { name:'Kimia Farma', file:'kimia-farma.svg', context:'Commercial analysis', type:'combination', tone:'color' },
  { name:'L’Oréal', file:'loreal.svg', context:'Brand analytics', type:'wordmark', tone:'mono' },
  { name:'Maybelline', file:'maybelline.svg', context:'Campaign monitoring', type:'wordmark', tone:'mono' },
  { name:'Pantene', file:'pantene.svg', context:'Campaign monitoring', type:'combination', tone:'color' },
  { name:'SilverQueen', file:'silverqueen.svg', context:'Social analytics', type:'combination', tone:'color' },
  { name:'Top Coffee', file:'top-coffee.svg', context:'Commercial analysis', type:'compact', tone:'color' },
  { name:'Ultra Milk', file:'ultra-milk.svg', context:'Commercial analysis', type:'combination', tone:'mono' },
];
const clientTracks = [clientLogos.filter((_, index) => index % 2 === 0), clientLogos.filter((_, index) => index % 2 === 1)];
---
<BaseLayout title="Farih Muwaffaq | Data Analyst & Analytics Automation" jsonLd={person} animate={true}>
  <section class="hero home-hero"><div class="container hero-layout">
    <div class="hero-copy"><p class="eyebrow rise"><span class="idx">00</span> Data systems · Commercial intelligence</p><h1 class="rise rise-1">Data, made decisive.</h1><p class="lede rise rise-2">I build analytics systems that move teams from raw signals to trusted, repeatable business decisions.</p><div class="actions rise rise-3"><a class="button" href="/work">Explore selected work<Icon name="arrow-up-right" /></a><a class="button secondary" href="/about">How I work<Icon name="arrow-right" /></a></div><p class="proof-line rise rise-4"><span><b>Experience</b> SKINTIFIC · Maleo · Lifepack.id · FMCG operations</span></p></div>
    <aside class="surface hero-cockpit rise rise-2 system-boot" data-system-boot><div class="surface-core cockpit-core"><div class="cockpit-header"><p class="availability">Operating layer · Jakarta</p><span class="mono">FM / 26</span></div><div class="signal-chart" aria-hidden="true"><svg viewBox="0 0 440 120" preserveAspectRatio="none"><path class="signal-grid" d="M0 24H440M0 60H440M0 96H440M88 0V120M176 0V120M264 0V120M352 0V120"/><path class="signal-area" d="M0 104L55 96L110 101L165 72L220 78L275 49L330 58L385 22L440 30V120H0Z"/><path class="signal-path" pathLength="1" d="M0 104L55 96L110 101L165 72L220 78L275 49L330 58L385 22L440 30"/><circle cx="385" cy="22" r="4"/></svg><span>Decision signal / normalized</span></div><div class="metric-stack"><div class="metric"><strong data-count-to={totalProjects} data-count-pad="2">{String(totalProjects).padStart(2,'0')}</strong><span>Case studies documented across {uniqueDomains} domains</span></div><div class="metric"><strong data-count-to={totalTouchpoints} data-count-suffix="+">{totalTouchpoints}+</strong><span>Brand &amp; org touchpoints across {uniqueOrgs} organizations</span></div><div class="metric"><strong data-count-to={impactMetric} data-count-suffix="%">1,567%</strong><span>Production capacity growth supported</span></div></div><div class="cockpit-footer"><span>Portfolio span</span><strong>2024 - present</strong><i></i></div></div></aside>
  </div></section>
  <section class="professional-orbit" aria-labelledby="professional-orbit-title" data-reveal data-professional-orbit><div class="container professional-orbit-heading"><div><p class="eyebrow"><span class="idx">01</span> Professional Orbit</p><h2 id="professional-orbit-title">Built across organizations and brands.</h2></div><p>Organizations where I worked and brands or projects I supported.</p></div><div class="professional-orbit-group"><div class="container professional-orbit-label"><span class="mono">Organizations</span><span>Employment and founder experience</span></div><div class="container career-timeline-wrap"><ol class="career-timeline" aria-label="Career timeline">{workplaceLogos.map((org,i)=><li class={`career-node${i===workplaceLogos.length-1?' is-current':''}`} tabindex="0" style={`--i:${i}`}><span class="timeline-years mono">{org.years}</span><span class="timeline-dot" aria-hidden="true"></span><img class="timeline-logo" src={`/images/logos/professional/${org.file}`} alt={org.name} data-logo-type={org.type} data-tone={org.tone} loading="lazy" decoding="async" />{i===workplaceLogos.length-1&&<span class="timeline-current mono">Current</span>}<b class="timeline-name">{org.name}</b><span class="timeline-role">{org.role}</span><p class="timeline-summary">{org.summary}</p></li>)}</ol></div></div><div class="professional-orbit-group client-orbit"><div class="container professional-orbit-label"><span class="mono">Brands &amp; portfolios worked with</span><span>Selected work delivered through agency, consulting, and project contexts</span><button type="button" data-orbit-toggle aria-pressed="false"><span>Pause motion</span><Icon name="pause" /></button></div><div class="professional-orbit-marquee professional-orbit-light" aria-label="Brands and projects I supported">{clientTracks.map((track,index)=><div class:list={['professional-orbit-track',index===1&&'professional-orbit-track-reverse']}><ul>{track.map(logo=><li><img src={`/images/logos/professional/${logo.file}`} alt={logo.name} data-logo-type={logo.type} data-tone="color" loading="lazy" decoding="async" /><span class="logo-context"><b>{logo.name}</b><span>{logo.context}</span></span></li>)}</ul><ul aria-hidden="true">{track.map(logo=><li><img src={`/images/logos/professional/${logo.file}`} alt="" data-logo-type={logo.type} data-tone="color" loading="lazy" decoding="async" /><span class="logo-context" aria-hidden="true"><b>{logo.name}</b><span>{logo.context}</span></span></li>)}</ul></div>)}</div></div></section>
  <section class="section work-zone" data-reveal><div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="idx">02</span> Selected work</p><h2>Systems built around decisions.</h2></div><p>Selected analytics systems spanning governed BI, automated reporting, and predictive modeling.</p></div><div class="work-bento">{projects.map((p,i)=><article class="card project"><div class="card-core project-core"><div class="project-head"><span class="mono">{String(i+1).padStart(2,'0')} / {p.data.organization}</span><span class="status">{p.data.evidenceType}</span></div><div class="project-media"><img src={p.data.coverImage} alt={p.data.coverAlt} width="800" height="450" loading={i===0?'eager':'lazy'} /></div><div class="project-body"><div><p class="eyebrow">{p.data.industry}</p><h3>{p.data.title}</h3><p>{p.data.summary}</p></div><a class="card-link" href={`/work/${p.data.slug}`} aria-label={`Read ${p.data.title}`}><Icon name="arrow-up-right" /></a><div class="project-meta"><span class="mono">{heroProof[p.data.slug]}</span></div></div></div></article>)}</div><div class="work-index-link"><span class="mono">03 selected / 09 total</span><a class="button secondary" href="/work">See all case studies<Icon name="arrow-right" /></a></div></div></section>
  <section class="section capability-zone" data-reveal data-operating-model><div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="idx">02</span> Operating model</p><h2>From infrastructure to action.</h2></div><p>Technical delivery stays connected to decision context, ownership, and measurable use.</p></div><div class="capability-map" role="list" aria-label="Analytics operating model"><div class="capability-line" aria-hidden="true"></div>{capabilities.map(({stage,term,definition,tools},i)=><article class="capability-step" role="listitem" tabindex="0" data-capability-step data-step={i+1}><div class="capability-node"><span>{String(i+1).padStart(2,'0')}</span></div><p class="mono">{stage}</p><h3>{term}</h3><p>{definition}</p><ul class="capability-tools" aria-label={`Tools used for ${stage}`}>{tools.map(tool=><li>{tool}</li>)}</ul></article>)}</div></div></section>
  <section class="section focus-zone" data-reveal><div class="container focus-layout"><div class="focus-copy"><p class="eyebrow"><span class="idx">03</span> Current focus</p><h2>Commercial and inventory intelligence.</h2><p class="lede">At SKINTIFIC, I support inventory and commercial analytics across brands and channels: stock health, pricing parity, NPD, critical SKU, and promotional analysis.</p><p class="quiet">Public descriptions remain high-level to protect confidential operating data.</p></div><div class="surface focus-system" data-commercial-system><div class="surface-core focus-core"><div class="focus-orbit"><button class="focus-center" type="button" data-commercial-reset aria-label="Reset commercial health view"><span data-center-kicker>Decision system</span><strong data-center-title>Commercial<br/>health</strong><small data-center-detail>Signal → context → action</small></button>{commercialInputs.map(([key,label,detail,title])=><button class={`orbit-item orbit-${key}`} type="button" data-commercial-node={key} data-title={title} data-detail={detail} aria-pressed="false">{label}</button>)}<svg viewBox="0 0 600 430" aria-hidden="true"><path data-connector="brand" d="M300 215L118 95"/><path data-connector="channel" d="M300 215L487 86"/><path data-connector="stock" d="M300 215L512 316"/><path data-connector="price" d="M300 215L116 337"/><path data-connector="npd" d="M300 215L300 38"/></svg></div><p class="sr-only" aria-live="polite" data-commercial-live>Commercial health decision system.</p><div class="focus-readout"><span><i></i> Governed inputs</span><span data-focus-status>Choose an input to inspect</span></div></div></div></div></section>
  <section class="section contact-zone" data-reveal><div class="container closing-layout"><div><p class="eyebrow"><span class="idx">04</span> Contact</p><h2>Need an analyst who connects systems to decisions?</h2></div><div class="closing-action"><p class="lede">Open to conversations about analytics, business intelligence, commercial performance, and automation.</p><div class="actions"><a class="button" href="/contact">Contact Farih<Icon name="arrow-up-right" /></a><a class="button secondary" href="/Farih-Muwaffaq-Resume.pdf" download="Farih-Muwaffaq-Resume.pdf">Download resume<Icon name="download" /></a></div><p class="availability">Available for high-impact data roles</p></div></div></section>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLElement>('[data-professional-orbit]').forEach(orbit => {
    const toggle = orbit.querySelector<HTMLButtonElement>('[data-orbit-toggle]');
    toggle?.addEventListener('click', () => {
      const paused = orbit.classList.toggle('is-paused');
      toggle.setAttribute('aria-pressed', String(paused));
      const label = toggle.querySelector('span');
      if (label) label.textContent = paused ? 'Resume motion' : 'Pause motion';
    });
  });
</script>
