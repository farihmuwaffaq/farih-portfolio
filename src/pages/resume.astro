---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { selectedCredentials } from '../data/credentials';
const skills=[['Data & engineering','SQL · PostgreSQL · MySQL · BigQuery · Python · Pandas · REST APIs'],['BI & analytics','Power BI · Tableau · Looker Studio · Metabase · Excel · Google Sheets'],['Business domains','Commercial analytics · Inventory · Operations · Marketing analytics · Data governance']];
const projects=[['01','ID/X Partners × Rakamin Academy','Loan default modeling'],['02','Kimia Farma × Rakamin Academy','Sales datamart and dashboard'],['03','Fairatmos','Forest carbon methodology hiring assessment']];
---
<BaseLayout title="Resume | Farih Muwaffaq" description="HTML resume for Farih Muwaffaq, Data Analyst in Jakarta with experience across FMCG, health-tech, and marketing analytics." footerVariant="resume">
<section class="section case-hero resume-page"><div class="container">
  <p class="eyebrow rise"><span class="idx">CV</span> Resume</p><h1 class="rise rise-1">Data Analyst building reliable systems for business decisions.</h1><p class="lede rise rise-2">Data analyst working across commercial analytics, automation, BI, and data systems—translating operational data into decision-ready information.</p><div class="actions rise rise-3"><a class="button" href="/Farih-Muwaffaq-Resume.pdf" download="Farih-Muwaffaq-Resume.pdf" data-event="resume_download">Download PDF<Icon name="download" /></a><a class="button secondary" href="mailto:farihmuwaffaq@gmail.com" data-event="email_click" data-event-label="resume_latest_copy">Get latest copy<Icon name="mail" /></a></div>
  <div class="resume-block resume-experience"><p class="eyebrow"><span class="idx">01</span> Experience</p>
    <div class="resume-item"><span class="when">June 2026 — present</span><div><h3>SKINTIFIC — Senior Associate Data Analyst</h3><p>Governed BI semantic definitions and row-level access while automating pricing snapshots and commercial monitoring across brands and channels.</p></div></div>
    <div class="resume-item"><span class="when">June 2025 — June 2026</span><div><h3>Future Creative Network (Maleo) — Data Analyst</h3><p>Built multi-source analytics pipelines and automated recurring reporting across four FMCG brands, improving consistency and reducing manual consolidation.</p></div></div>
    <div class="resume-item"><span class="when">November 2024 — April 2025</span><div><h3>Lifepack.id — Data Analyst</h3><p>Developed and maintained 10+ operational dashboards and reports, supporting visibility while validating data and escalating integrity risks.</p></div></div>
    <div class="resume-item"><span class="when">March — October 2024</span><div><h3>PT Gajahpangan Jaya Makmur — Data Analyst</h3><p>Supported production growth from 300 to 5,000 units/day and monthly profit growth from below IDR 100M to above IDR 700M through operational and commercial analysis.</p></div></div>
    <div class="resume-item"><span class="when">August 2021 — June 2023</span><div><h3>Selasar Kampus — Founder and CEO</h3><p>Founded an education initiative and led early-stage product, stakeholder, and operational development.</p></div></div>
  </div>
  <div class="resume-block"><p class="eyebrow"><span class="idx">02</span> Education</p><div class="resume-item"><span class="when">Jan 2026 — present</span><div><h3>PPM School of Management — Master of Management</h3><p>Current study focused on strategy, management, and business decision-making.</p></div></div><div class="resume-item"><span class="when">2019 — 2023</span><div><h3>Institut Teknologi Bandung — Bachelor of Forestry Engineering</h3><p>Systems-oriented foundation spanning resource constraints, evidence, and long-term outcomes.</p></div></div></div>
  <div class="resume-block" id="skills"><p class="eyebrow"><span class="idx">03</span> Skills</p><div class="resume-skills">{skills.map(([category,items])=><article><h3>{category}</h3><p>{items}</p></article>)}</div></div>
  <div class="resume-block resume-projects"><p class="eyebrow"><span class="idx">04</span> Selected applied projects</p><div>{projects.map(([index,name,scope])=><article><span class="mono">{index}</span><h3>{name}</h3><p>{scope}</p></article>)}</div></div>
  <div class="resume-block resume-credentials"><p class="eyebrow"><span class="idx">05</span> Certifications &amp; Professional Training</p><div class="credential-list">{selectedCredentials.map(({year,issuer,title,href})=><a href={href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${title} credential (PDF)`}><span class="mono">{year}</span><span><strong>{issuer}</strong><small>{title}</small></span><span aria-hidden="true">↗</span></a>)}</div></div>
</div></section>
</BaseLayout>
