---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Farih Muwaffaq" description="The requested page could not be found.">
  <section class="hero"><div class="container">
    <p class="eyebrow rise"><span class="idx">404</span> Out of range</p>
    <h1 class="hero-name rise rise-1">This page is outside the model.</h1>
    <p class="lede rise rise-2">The link may be outdated or the address may be incomplete.</p>
    <div class="actions rise rise-3"><a class="button" href="/">Return home</a><a class="button secondary" href="/work">Browse work</a></div>
  </div></section>
</BaseLayout>
