---
import BaseLayout from '../layouts/BaseLayout.astro';
const profile={'@context':'https://schema.org','@type':'ProfilePage',mainEntity:{'@type':'Person',name:'Farih Muwaffaq',jobTitle:'Data Analyst'}};
const career = [
  ['SKINTIFIC','Senior Associate Data Analyst','June 2026 — present','Contribution: governed BI, semantic definitions, row-level access, pricing snapshots, and commercial monitoring across brands and channels.'],
  ['Future Creative Network (Maleo)','Data Analyst','June 2025 — June 2026','Contribution: end-to-end KPI workflows, multi-source pipelines, recurring reporting automation, dashboards, and AI-assisted performance nudges for four FMCG brands.'],
  ['Lifepack.id','Data Analyst','November 2024 — April 2025','Contribution: data validation, central-system integration, 10+ operational dashboards and reports, and escalation of data-integrity risks.'],
  ['PT Gajahpangan Jaya Makmur','Data Analyst','March — October 2024','Contribution: production and profit bottleneck analysis supporting capacity growth from 300 to 5,000 units/day and channel expansion.'],
  ['Selasar Kampus','Founder and CEO','August 2021 — June 2023','Built an education-startup initiative and developed entrepreneurial and stakeholder experience. Specific incubation, traction, and funding claims are not published because supporting evidence has not been verified.'],
];
const capabilities = [
  ['01 / SYSTEMS','Analytics systems and automation','Pipelines, semantic layers, scheduled reports, dashboards, and recovery workflows.'],
  ['02 / DECISIONS','Commercial and operational analysis','Production, pricing, channel, inventory, and performance signals tied to action.'],
  ['03 / TRUST','Data quality and governance','Clear definitions, validation, access control, and escalation paths around sensitive data.'],
];
const technical = [
  ['Data & querying','SQL · BigQuery · PostgreSQL · MySQL'],
  ['Analysis & modeling','Python · Pandas · NumPy · scikit-learn · Jupyter'],
  ['BI & reporting','Looker Studio · Power BI · Tableau · Metabase'],
  ['Operational workflows','Excel · Google Sheets · REST APIs · TablePlus'],
];
---
<BaseLayout title="About Farih Muwaffaq | Data Analyst" description="About Farih Muwaffaq: analytics systems, commercial analysis, management education, and Forestry Engineering background." jsonLd={profile}>
  <section class="section about-hero"><div class="container about-hero-grid">
    <div class="about-intro"><p class="eyebrow rise"><span class="idx">Profile</span> About</p><h1 class="rise rise-1">Systems thinking, business context, practical analysis.</h1><p class="lede rise rise-2">I am a Data Analyst who works across analytics systems, reporting automation, commercial analysis, and stakeholder communication.</p><p class="rise rise-3">I tend to start with the business question, trace the data and operational systems behind it, then build analysis that helps people decide what to do next.</p><aside class="about-glance rise rise-3"><dl><div class="g-row"><dt>Currently</dt><dd>Senior Associate Data Analyst, SKINTIFIC</dd></div><div class="g-row"><dt>Focus</dt><dd>Commercial analytics, inventory, pricing, reporting automation</dd></div><div class="g-row"><dt>Location</dt><dd>Jakarta, Indonesia</dd></div><div class="g-row"><dt>Open to</dt><dd>Analytics systems &amp; decision-support work</dd></div></dl></aside></div>
    <figure class="about-portrait rise rise-2"><img src="/images/farih.png" alt="Portrait of Farih Muwaffaq" width="928" height="1080" loading="eager" /><figcaption><span class="availability">Jakarta · Indonesia</span><span class="mono">Data / decisions / systems</span></figcaption></figure>
  </div></section>
  <section class="section about-method"><div class="container"><div class="section-heading about-method-heading"><div><p class="eyebrow"><span class="idx">01</span> How I work</p><h2>From question to useful action.</h2></div><p>Business context organizes the work. Tools, models, and dashboards support a decision rather than becoming the outcome.</p></div><div class="grid three contribution-summary">{capabilities.map(([index,title,description])=><article><span class="mono">{index}</span><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
  <section class="section about-career"><div class="container"><p class="eyebrow"><span class="idx">02</span> Career</p><h2>A selective timeline.</h2><div class="resume-block">{career.map(([org,role,when,desc],i)=><div class:list={['resume-item',i===0&&'is-current']}><span class="when">{when}</span><div><h3><span class="mono resume-index">{String(i+1).padStart(2,'0')}</span>{role} · {org}</h3><p>{desc}</p></div></div>)}</div></div></section>
  <section class="section foundation-zone"><div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="idx">03</span> Foundation</p><h2>Management and systems perspective.</h2></div><p>Formal study and operating experience shape how I connect technical work to organizational consequences.</p></div><div class="foundation-grid"><div class="foundation-study"><article><span class="mono">Management / current</span><h3>PPM School of Management</h3><p>Master of Management, January 2026 — present. Extending technical analysis through commercial, strategic, and organizational context.</p></article><article><span class="mono">Systems / foundation</span><h3>Institut Teknologi Bandung</h3><p>Bachelor of Forestry Engineering, 2018 — 2023. A systems foundation shaped by interconnected resources, constraints, evidence, and long-term outcomes.</p></article></div><blockquote class="panel endorsement"><p>&ldquo;We are always directed to create useful and relevant content based on data. His ability to analyze the latest trends and markets in data-driven content creation is undeniable.&rdquo;</p><footer class="endorsement-by">Fadhila Hanna Ramdhani<span class="endorsement-role">Forestry Engineering, Institut Teknologi Bandung · reported directly to Farih, Selasar Kampus</span></footer></blockquote></div></div></section>
  <section class="section technical-zone"><div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="idx">04</span> Technical range</p><h2>Tools organized by purpose.</h2></div><p>Capability matters more than inventory. Each tool belongs to a specific part of the analytical workflow.</p></div><div class="technical-grid">{technical.map(([category,tools],i)=><article><span class="mono">{String(i+1).padStart(2,'0')}</span><h3>{category}</h3><p>{tools}</p></article>)}</div><p class="tool-note">Tools support the work; decisions remain the organizing principle.</p></div></section>
</BaseLayout>
